---
interface Props {
  kind: "sunset" | "rain" | "lamp" | "city" | "garden" | "train";
  light?: boolean;
}

const { kind, light = false } = Astro.props;
const stroke = light ? "rgba(250, 246, 236, 0.6)" : "rgba(43, 38, 33, 0.36)";
const fill = light ? "rgba(250, 246, 236, 0.24)" : "rgba(43, 38, 33, 0.13)";
---

<svg viewBox="0 0 144 128" aria-hidden="true" class="motif">
  {
    kind === "sunset" && (
      <>
        <circle cx="72" cy="58" r="17" fill={fill} stroke={stroke} stroke-width="1" />
        <path d="M28 84h88M18 96h108M38 108h68" stroke={stroke} stroke-width="1" stroke-linecap="round" />
      </>
    )
  }
  {
    kind === "rain" && (
      <>
        <path d="M30 54c0-9 7-16 16-16 2-9 10-15 19-15 11 0 20 8 20 19 0 1 0 2-.4 3" fill="none" stroke={stroke} stroke-width="1.2" stroke-linecap="round" />
        <path d="M40 74l-6 16M58 72l-6 18M76 74l-6 16M94 72l-6 18" stroke={stroke} stroke-width="1.2" stroke-linecap="round" />
      </>
    )
  }
  {
    kind === "lamp" && (
      <>
        <path d="M72 22v18" stroke={stroke} stroke-width="1.2" />
        <path d="M54 40h36l-7 26H61z" fill={fill} stroke={stroke} stroke-width="1.1" stroke-linejoin="round" />
        <path d="M72 66v34M52 100h40" stroke={stroke} stroke-width="1.1" stroke-linecap="round" />
      </>
    )
  }
  {
    kind === "city" && (
      <>
        <path d="M26 104V64h18v40M44 104V46h20v58M64 104V72h18v32M82 104V56h20v48" fill="none" stroke={stroke} stroke-width="1.1" />
        <path d="M50 58h3M60 58h3M50 70h3M60 70h3M68 82h3M90 68h3M90 82h3" stroke={stroke} stroke-width="1.6" stroke-linecap="round" />
      </>
    )
  }
  {
    kind === "garden" && (
      <>
        <path d="M18 100h108" stroke={stroke} stroke-width="1.1" stroke-linecap="round" />
        <path d="M60 100V56M84 100V64" stroke={stroke} stroke-width="1.1" stroke-linecap="round" />
        <path d="M60 74c-12 0-20-6-20-16 10 0 20 5 20 16zM60 62c0-11 7-18 18-18 0 11-7 18-18 18zM84 80c9 0 15-5 15-13-8 0-15 4-15 13z" fill={fill} stroke={stroke} stroke-width="1" stroke-linejoin="round" />
      </>
    )
  }
  {
    kind === "train" && (
      <>
        <path d="M16 102h112M30 92h84" stroke={stroke} stroke-width="1" stroke-linecap="round" />
        <path d="M40 92V52h64v40" fill={fill} stroke={stroke} stroke-width="1.2" stroke-linejoin="round" />
        <path d="M52 64h16M52 74h16" stroke={stroke} stroke-width="1.4" stroke-linecap="round" />
        <circle cx="54" cy="86" r="3" fill={stroke} />
        <circle cx="90" cy="86" r="3" fill={stroke} />
      </>
    )
  }
</svg>

<style>
  .motif {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
